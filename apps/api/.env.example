# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (PostgreSQL 15+) ───────────────────────────
# Local: run `npm run db:local:init` at the repo root (creates a cluster on port 54329).
# Cloud: paste your Neon/Supabase connection string (use the pooled URL + ?sslmode=require).
DATABASE_URL="postgresql://fitclub:fitclub_dev@127.0.0.1:54329/fitclub?schema=public"
# Direct (non-pooled) URL for `prisma migrate` when DATABASE_URL points at a pooler (Neon "-pooler" host).
DIRECT_URL=
# Used only by integration tests; it is wiped on every run.
TEST_DATABASE_URL="postgresql://fitclub:fitclub_dev@127.0.0.1:54329/fitclub_test?schema=public"

# ── Web / cookies ───────────────────────────────────────
# Origin allowed to call the API with credentials (the Next.js app).
WEB_ORIGIN=http://localhost:3000
# Base URL used in e-mailed links (password reset, invitations).
PUBLIC_WEB_URL=http://localhost:3000
# Must be true in production (HTTPS).
COOKIE_SECURE=false

# ── Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
QR_SIGNING_SECRET=change-me-32-bytes-minimum-random-value

# ── Payments ────────────────────────────────────────────
# Sandbox adapter: never moves money. Refused when NODE_ENV=production unless DEMO_MODE=true.
PAYMENTS_SANDBOX_ENABLED=true
SANDBOX_WEBHOOK_SECRET=change-me-random-value
# Public portfolio demo with no real customers: allows the labelled sandbox in production.
DEMO_MODE=false

# ── E-mail ──────────────────────────────────────────────
# Leave SMTP_HOST empty to run without e-mail delivery: messages are stored with status SKIPPED.
EMAIL_FROM="FITCLUB <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Development only: print e-mail bodies (incl. reset links) to the API log.
EMAIL_DEV_LOG=true

# ── Media storage ───────────────────────────────────────
# "local" writes to UPLOAD_DIR (needs a persistent disk). "database" stores images in PostgreSQL (serverless/Vercel).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# ── Background jobs ─────────────────────────────────────
# In-process scheduler. Disable on serverless hosts and let Vercel Cron call /api/cron/daily instead.
JOBS_ENABLED=true
# Bearer secret Vercel Cron sends to /api/cron/daily (empty = endpoint disabled).
CRON_SECRET=

# ── Proxy ───────────────────────────────────────────────
# Header with the real client IP behind a proxy chain (Vercel: x-vercel-forwarded-for). Empty = req.ip.
CLIENT_IP_HEADER=

# ── Demo data (development only) ─────────────────────────
# Password for all seeded demo accounts. Leave empty to generate one (printed once by the seed).
SEED_DEMO_PASSWORD=
